# Multi-stage build
FROM python:3.13-slim AS builder

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.api.txt .

RUN python -m venv /venv && \
    /venv/bin/pip install --upgrade pip && \
    /venv/bin/pip install --no-cache-dir -r requirements.api.txt && \
    /venv/bin/pip install --no-cache-dir --upgrade \
        "msgpack>=1.2.3,<2" \
        "setuptools>=78.1.1" \
        "urllib3>=2.8.0,<3" && \
    /venv/bin/pip check && \
    /venv/bin/pip show msgpack setuptools urllib3

FROM python:3.13-slim AS runtime

WORKDIR /fink_api_anomaly_detection

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/venv/bin:$PATH"

COPY --from=builder /venv /venv

COPY src ./src
COPY artifacts/ae ./artifacts/ae

EXPOSE 8000
CMD ["uvicorn", "fink_api_anomaly_detection.api:app", "--app-dir", "src", "--host", "0.0.0.0", "--port", "8000"]